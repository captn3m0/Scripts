#!/bin/bash
set -e

# Get origin URL
url=$(git remote get-url origin)

# Extract owner/repo from GitHub URL (SSH or HTTPS)
if [[ $url =~ github\.com[:/]([^/]+)/([^/\.]+)(\.git)? ]]; then
    owner="${BASH_REMATCH[1]}"
    repo="${BASH_REMATCH[2]}"
else
    echo "Error: origin is not a GitHub repository"
    exit 1
fi

# Check if repo is public via GitHub API
response=$(curl -s "https://api.github.com/repos/$owner/$repo")
is_private=$(echo "$response" | jq -r '.private')

if [ "$is_private" != "false" ]; then
    echo "Repository is not public (or API check failed)"
    exit 1
fi

echo "Repository is public. Splitting remote URLs..."

# Generate both HTTPS and SSH URLs
https_url="https://github.com/$owner/$repo.git"
ssh_url="git@github.com:$owner/$repo.git"

# Remove and recreate origin with HTTPS fetch and SSH push
git remote remove origin
git remote add origin "$https_url"
git remote set-url --add --push origin "$ssh_url"

echo "Done. Fetch URL (HTTPS) and push URL (SSH) are now separate for origin."
git remote -v